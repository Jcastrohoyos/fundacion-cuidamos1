# Google Analytics - Obtén tu ID en https://analytics.google.com/
# Sin prefijo NEXT_PUBLIC_: se lee en Server Component durante el build,
# así Vercel no lo trata como valor expuesto al navegador.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Formulario de confirmación para transferencias Breve (opcional)
# NEXT_PUBLIC_DONATION_FORM_LINK=

# Enlaces de pago o solicitud para las opciones del modal
# Si no se configura uno, se abre WhatsApp con el mensaje correspondiente
# NEXT_PUBLIC_MEAL_VOUCHER_LINK=
# NEXT_PUBLIC_GIFT_BAG_LINK=
# NEXT_PUBLIC_MEMORIAL_VOUCHER_LINK=
