# Google Analytics - Obtén tu ID en https://analytics.google.com/
# Sin prefijo NEXT_PUBLIC_: se lee en Server Component durante el build,
# así Vercel no lo trata como valor expuesto al navegador.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Formulario de donación (opcional) - si no existe, se usa el enlace por defecto
# NEXT_PUBLIC_DONATION_FORM_LINK=
